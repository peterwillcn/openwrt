diff -ruN linux-pristine/drivers/misc/zte_card_holder_det.c linux-port/drivers/misc/zte_card_holder_det.c
--- a/drivers/misc/zte_card_holder_det.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/misc/zte_card_holder_det.c	2026-11-17 02:08:47.230093624 +0000
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ZTE card holder (tray) detection: /sys/zcard_det/zcard_det reads 1 with the tray in and 0 without.
+ *
+ * Ported from the ZTE 5.4 kernel (drivers/vendor/common/zcard_det/zte_card_holder_det.c, ZTE bsp light, 2022). It
+ * takes the line from the first node with a "zcard-holder-det-gpios" property, or else from the first with
+ * "cd-gpios" (on the F50 the card slot's detect line, the tray's), and reports its logical value (polarity
+ * included). The 5.4 driver read the line without requesting it; mainline has to request it, and does so at
+ * read time (see zcard_read()), so neither the GPIO controller's probe order nor the SD host's is in the way. A board with neither property (the U30 Air) gets no file, as on 5.4.
+ */
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/init.h>
+#include <linux/kobject.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/sysfs.h>
+
+static struct device_node *zcard_np;
+static const char *zcard_con;
+/* the line as shared with its owner (the SD host); never freed here, the owner holds it */
+static struct gpio_desc *zcard_shared;
+static struct kobject *zcard_kobj;
+static DEFINE_MUTEX(zcard_lock);
+
+/*
+ * The line's logical value. The card slot's host normally holds the line (its card detect): then it is shared
+ * (asked for non-exclusively once, and kept). If nobody holds it, it is requested only for the read and given
+ * back at once, so this file never keeps the SD host from getting its card detect.
+ */
+static int zcard_read(void)
+{
+	struct fwnode_handle *fw = of_fwnode_handle(zcard_np);
+	struct gpio_desc *d;
+	int v;
+
+	mutex_lock(&zcard_lock);
+	if (!zcard_shared) {
+		d = fwnode_gpiod_get_index(fw, zcard_con, 0, GPIOD_ASIS, "zcard_det");
+		if (!IS_ERR(d)) {
+			v = gpiod_get_value_cansleep(d);
+			gpiod_put(d);
+			goto out;
+		}
+		if (PTR_ERR(d) != -EBUSY) {
+			v = PTR_ERR(d) == -EPROBE_DEFER ? -EAGAIN : PTR_ERR(d);
+			goto out;
+		}
+		d = fwnode_gpiod_get_index(fw, zcard_con, 0, GPIOD_ASIS | GPIOD_FLAGS_BIT_NONEXCLUSIVE,
+					   "zcard_det");
+		if (IS_ERR(d)) {
+			v = PTR_ERR(d);
+			goto out;
+		}
+		zcard_shared = d;
+	}
+	v = gpiod_get_value_cansleep(zcard_shared);
+out:
+	mutex_unlock(&zcard_lock);
+	return v;
+}
+
+static ssize_t zcard_det_show(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+	int v = zcard_read();
+
+	if (v < 0)
+		return v;
+	return sysfs_emit(buf, "%d\n", v);
+}
+static struct kobj_attribute zcard_det_attr = __ATTR(zcard_det, 0444, zcard_det_show, NULL);
+
+static int __init zte_card_holder_det_init(void)
+{
+	int ret;
+
+	zcard_np = of_find_node_with_property(NULL, "zcard-holder-det-gpios");
+	zcard_con = "zcard-holder-det";
+	if (!zcard_np) {
+		zcard_np = of_find_node_with_property(NULL, "cd-gpios");
+		zcard_con = "cd";
+	}
+	if (!zcard_np) {
+		pr_info("zcard_det: no card holder detect line on this board\n");
+		return -ENODEV;
+	}
+	zcard_kobj = kobject_create_and_add("zcard_det", NULL);
+	if (!zcard_kobj) {
+		of_node_put(zcard_np);
+		return -ENOMEM;
+	}
+	ret = sysfs_create_file(zcard_kobj, &zcard_det_attr.attr);
+	if (ret) {
+		kobject_put(zcard_kobj);
+		of_node_put(zcard_np);
+		return ret;
+	}
+	pr_info("zcard_det: card holder detect on %pOF (%s-gpios)\n", zcard_np, zcard_con);
+	return 0;
+}
+module_init(zte_card_holder_det_init);
+
+static void __exit zte_card_holder_det_exit(void)
+{
+	sysfs_remove_file(zcard_kobj, &zcard_det_attr.attr);
+	kobject_put(zcard_kobj);
+	of_node_put(zcard_np);
+}
+module_exit(zte_card_holder_det_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("ZTE card holder detection");
diff -ruN linux-pristine/drivers/misc/zte-v50-sim.c linux-port/drivers/misc/zte-v50-sim.c
--- a/drivers/misc/zte-v50-sim.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/misc/zte-v50-sim.c	2026-11-17 02:08:47.229966257 +0000
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ZTE V50 (MU3351) SIM multiplexer, on the stock "zte,sim_gpio_ctrl" binding.
+ *
+ * From kanoqwq's reconstruction of the stock B15 sim_gpio_ctl module (kanoqwq/mu300-linux f0ed60ff, b4c051c8).
+ * The modem has two SIM interfaces; a V50 can carry up to four cards, so two of them sit behind board switches:
+ *   soft-psim-switch    SIM1's interface: 0 the first built-in card, 1 the external card (tray)
+ *   esim2-esim3-switch  SIM2's interface: 0 the second built-in card, 1 the third one
+ *   esim1-psim-switch   an INPUT despite its name: the card holder's detect line; never written
+ *
+ * MU300 (docs/FINDINGS.md 204): nothing is driven at probe. The stock module set both outputs from
+ * androidboot.simswitch/psimswitch, or high/low without them; this one takes the lines as the bootloader left them,
+ * so a V50 whose owner never chose a card keeps exactly the routing it had before this driver existed. A level is
+ * written only when userspace asks for one (mu300-sim, before the modem's CP starts, at the boot after a choice),
+ * and only when it differs from the line's present level. Every GPIO number comes from the board's device tree.
+ */
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/sysfs.h>
+
+struct v50_sim {
+	struct gpio_desc *detect, *chip, *psim;
+	struct mutex lock;
+};
+
+static ssize_t v50_read(struct v50_sim *sim, struct gpio_desc *gpio, char *buf)
+{
+	int value;
+
+	mutex_lock(&sim->lock);
+	value = gpiod_get_value_cansleep(gpio);
+	mutex_unlock(&sim->lock);
+	return value < 0 ? value : sysfs_emit(buf, "%d\n", value);
+}
+
+static ssize_t v50_write(struct v50_sim *sim, struct gpio_desc *gpio, const char *buf, size_t count)
+{
+	unsigned int value;
+	int ret;
+
+	ret = kstrtouint(buf, 10, &value);
+	if (ret || value > 1)
+		return -EINVAL;
+	mutex_lock(&sim->lock);
+	ret = gpiod_get_value_cansleep(gpio);
+	/* the same level: the line is left as it is (an input the bootloader left with a pull stays one) */
+	if (ret >= 0 && ret != value)
+		ret = gpiod_direction_output(gpio, value);
+	if (ret >= 0) {
+		ret = gpiod_get_value_cansleep(gpio);
+		if (ret >= 0)
+			ret = ret == value ? 0 : -EIO;
+	}
+	mutex_unlock(&sim->lock);
+	return ret < 0 ? ret : count;
+}
+
+static ssize_t chip_select_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct v50_sim *sim = dev_get_drvdata(dev);
+
+	return v50_read(sim, sim->chip, buf);
+}
+
+static ssize_t chip_select_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct v50_sim *sim = dev_get_drvdata(dev);
+
+	return v50_write(sim, sim->chip, buf, count);
+}
+
+static ssize_t psim_select_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct v50_sim *sim = dev_get_drvdata(dev);
+
+	return v50_read(sim, sim->psim, buf);
+}
+
+static ssize_t psim_select_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct v50_sim *sim = dev_get_drvdata(dev);
+
+	return v50_write(sim, sim->psim, buf, count);
+}
+
+static ssize_t psim_present_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct v50_sim *sim = dev_get_drvdata(dev);
+
+	return v50_read(sim, sim->detect, buf);
+}
+
+static DEVICE_ATTR_RW(chip_select);
+static DEVICE_ATTR_RW(psim_select);
+static DEVICE_ATTR_RO(psim_present);
+static struct attribute *v50_sim_attrs[] = {
+	&dev_attr_chip_select.attr,
+	&dev_attr_psim_select.attr,
+	&dev_attr_psim_present.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(v50_sim);
+
+static int v50_sim_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *v50;
+	struct v50_sim *sim;
+
+	/* other boards' vendor trees may carry an unused node of this binding: the V50 is the one with the AW9523B */
+	v50 = of_find_compatible_node(NULL, NULL, "awinic,aw9523b");
+	if (!v50)
+		return -ENODEV;
+	of_node_put(v50);
+	sim = devm_kzalloc(dev, sizeof(*sim), GFP_KERNEL);
+	if (!sim)
+		return -ENOMEM;
+	mutex_init(&sim->lock);
+	/* the stock binding spells these with a singular -gpio, which gpiolib also takes; GPIOD_ASIS: no level set */
+	sim->detect = devm_gpiod_get(dev, "esim1-psim-switch", GPIOD_ASIS);
+	if (IS_ERR(sim->detect))
+		return dev_err_probe(dev, PTR_ERR(sim->detect), "card detect GPIO\n");
+	sim->chip = devm_gpiod_get(dev, "esim2-esim3-switch", GPIOD_ASIS);
+	if (IS_ERR(sim->chip))
+		return dev_err_probe(dev, PTR_ERR(sim->chip), "SIM2 selector GPIO\n");
+	sim->psim = devm_gpiod_get(dev, "soft-psim-switch", GPIOD_ASIS);
+	if (IS_ERR(sim->psim))
+		return dev_err_probe(dev, PTR_ERR(sim->psim), "SIM1 selector GPIO\n");
+	platform_set_drvdata(pdev, sim);
+	dev_info(dev, "MU300: ZTE V50 SIM switches, SIM1 %d, SIM2 %d (left as found)\n",
+		 gpiod_get_value_cansleep(sim->psim), gpiod_get_value_cansleep(sim->chip));
+	return 0;
+}
+
+static const struct of_device_id v50_sim_match[] = {
+	{ .compatible = "zte,sim_gpio_ctrl" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, v50_sim_match);
+
+static struct platform_driver v50_sim_driver = {
+	.probe = v50_sim_probe,
+	.driver = {
+		.name = "zte-v50-sim",
+		.of_match_table = v50_sim_match,
+		.dev_groups = v50_sim_groups,
+	},
+};
+module_platform_driver(v50_sim_driver);
+MODULE_DESCRIPTION("ZTE V50 SIM multiplexer (stock zte,sim_gpio_ctrl binding)");
+MODULE_LICENSE("GPL");
diff -ruN linux-pristine/drivers/mmc/host/sdhci-sprd.c linux-port/drivers/mmc/host/sdhci-sprd.c
