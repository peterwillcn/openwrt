diff -ruN linux-pristine/drivers/mfd/ump962x-pmic.c linux-port/drivers/mfd/ump962x-pmic.c
--- a/drivers/mfd/ump962x-pmic.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/mfd/ump962x-pmic.c	2026-11-17 02:08:47.228337825 +0000
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Unisoc UMP9621 and UMP9622: the two companion PMICs of the UMP9620 (pmic@1 and pmic@2 on the ADI bus).
+ *
+ * They answer on the same ADI bus as the UMP9620, at register offsets 0x8000 (UMP9621) and 0xc000 (UMP9622), and
+ * have no interrupts. This driver gives each a regmap with that offset and populates its device tree sub-nodes,
+ * which take the regmap from their parent: the UMP9621's regulators (vddcpu0, vddsram1/2, vddai, vddmm,
+ * DCDC_MODEM), its eFuse and global registers, the UMP9622's temperature sensors and global registers.
+ *
+ * From the Unisoc 5.4 kernel's MFD (drivers/mfd/sprd-ump96xx-spi.c, Luyao Wu), which handles all three PMICs; on
+ * mainline the UMP9620 stays with sprd-sc27xx-spi (patched in upstream/port/install.py), and this driver takes the
+ * other two. Its name is the 5.4 driver's.
+ */
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mod_devicetable.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/spi/spi.h>
+
+struct ump962x_pmic {
+	u32 slave_id;
+};
+
+static int ump962x_spi_write(void *context, const void *data, size_t count)
+{
+	struct spi_device *spi = to_spi_device(context);
+	const struct ump962x_pmic *p = spi_get_drvdata(spi);
+	u32 buf[2];
+
+	/* one register and its value: the ADI controller takes them as two words */
+	if (count != sizeof(buf))
+		return -EINVAL;
+	memcpy(buf, data, count);
+	buf[0] += p->slave_id;
+	return spi_write(spi, buf, count);
+}
+
+static int ump962x_spi_read(void *context, const void *reg, size_t reg_size, void *val, size_t val_size)
+{
+	struct spi_device *spi = to_spi_device(context);
+	const struct ump962x_pmic *p = spi_get_drvdata(spi);
+	u32 rx_buf[2] = { 0 };
+	int ret;
+
+	if (reg_size != sizeof(u32) || val_size != sizeof(u32))
+		return -EINVAL;
+	memcpy(rx_buf, reg, sizeof(u32));
+	rx_buf[0] += p->slave_id;
+	ret = spi_read(spi, rx_buf, 1);
+	if (ret < 0)
+		return ret;
+	memcpy(val, rx_buf, val_size);
+	return 0;
+}
+
+static const struct regmap_bus ump962x_regmap_bus = {
+	.write = ump962x_spi_write,
+	.read = ump962x_spi_read,
+	.reg_format_endian_default = REGMAP_ENDIAN_NATIVE,
+	.val_format_endian_default = REGMAP_ENDIAN_NATIVE,
+};
+
+static const struct regmap_config ump962x_regmap_config = {
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.max_register = 0x3fff,
+};
+
+static int ump962x_probe(struct spi_device *spi)
+{
+	struct ump962x_pmic *p;
+	struct regmap *map;
+
+	p = devm_kzalloc(&spi->dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->slave_id = (uintptr_t)spi_get_device_match_data(spi);
+	spi_set_drvdata(spi, p);
+	map = devm_regmap_init(&spi->dev, &ump962x_regmap_bus, &spi->dev, &ump962x_regmap_config);
+	if (IS_ERR(map))
+		return dev_err_probe(&spi->dev, PTR_ERR(map), "cannot set up the register map\n");
+	return devm_of_platform_populate(&spi->dev);
+}
+
+static const struct of_device_id ump962x_of_match[] = {
+	{ .compatible = "sprd,ump9621", .data = (void *)0x8000 },
+	{ .compatible = "sprd,ump9622", .data = (void *)0xc000 },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ump962x_of_match);
+
+static const struct spi_device_id ump962x_spi_ids[] = {
+	{ "ump9621", 0x8000 },
+	{ "ump9622", 0xc000 },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, ump962x_spi_ids);
+
+static struct spi_driver ump962x_driver = {
+	.driver = {
+		.name = "ump96xx-pmic",
+		.of_match_table = ump962x_of_match,
+	},
+	.probe = ump962x_probe,
+	.id_table = ump962x_spi_ids,
+};
+
+static int __init ump962x_init(void)
+{
+	return spi_register_driver(&ump962x_driver);
+}
+subsys_initcall(ump962x_init);
+
+static void __exit ump962x_exit(void)
+{
+	spi_unregister_driver(&ump962x_driver);
+}
+module_exit(ump962x_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Unisoc UMP9621/UMP9622 companion PMICs");
diff -ruN linux-pristine/drivers/misc/board_state.c linux-port/drivers/misc/board_state.c
--- a/drivers/misc/board_state.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/misc/board_state.c	2026-11-17 02:08:47.230217426 +0000
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+/*
+ * ZTE board state: the board ID and the secure-boot (eFuse) state the bootloader passes on its command line
+ * (androidboot.zte_boardid=, efuse_state=), as /proc/driver/board_id, /dev/zte_board_state with its secstate
+ * attribute, and zte_get_boardid()/zte_get_efuse_state() for other drivers.
+ *
+ * Ported from the ZTE 5.4 kernel (drivers/vendor/soc/sprd/board_state/board_state.c). Mainline forces its own
+ * command line, so, as on 5.4, the values are read from the device tree's /chosen/bootargs, which still holds the
+ * bootloader's. The misc device's open and ioctl do nothing, as on 5.4.
+ */
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+
+#define BOARDID_CMDLINE_STR	"androidboot.zte_boardid="
+#define EFUSE_STATE_CMDLINE_STR	"efuse_state="
+#define EFUSE_ENABLE_VALUE	5
+
+static int boardid = -1;
+static int efuse_state = -1;
+
+/* the number after KEY in the command line, as 5.4 parsed it (kstrtol base 0, at most 15 characters) */
+static int cmdline_value(const char *cmdline, const char *key, long *value)
+{
+	const char *p = strstr(cmdline, key);
+	char buf[16];
+	size_t n;
+
+	if (!p)
+		return -ENOENT;
+	p += strlen(key);
+	p = skip_spaces(p);
+	n = strcspn(p, " \t\n");
+	if (!n || n >= sizeof(buf))
+		return -EINVAL;
+	memcpy(buf, p, n);
+	buf[n] = '\0';
+	return kstrtol(buf, 0, value);
+}
+
+int zte_get_boardid(void)
+{
+	return boardid;
+}
+EXPORT_SYMBOL(zte_get_boardid);
+
+int zte_get_efuse_state(void)
+{
+	return efuse_state;
+}
+EXPORT_SYMBOL(zte_get_efuse_state);
+
+static ssize_t secstate_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%d\n", efuse_state);
+}
+static DEVICE_ATTR_RO(secstate);
+
+static struct attribute *zte_board_state_attrs[] = {
+	&dev_attr_secstate.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(zte_board_state);
+
+static int zte_board_state_open(struct inode *inode, struct file *file)
+{
+	return 0;
+}
+
+static long zte_board_state_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	return 0;
+}
+
+static const struct file_operations zte_board_state_fops = {
+	.owner = THIS_MODULE,
+	.open = zte_board_state_open,
+	.unlocked_ioctl = zte_board_state_ioctl,
+};
+
+static struct miscdevice zte_board_state_dev = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "zte_board_state",
+	.fops = &zte_board_state_fops,
+	.groups = zte_board_state_groups,
+};
+
+static int board_id_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "%d\n", boardid);
+	return 0;
+}
+
+static int __init zte_board_state_init(void)
+{
+	struct device_node *chosen;
+	const char *cmdline = NULL;
+	long v;
+	int ret;
+
+	chosen = of_find_node_by_path("/chosen");
+	ret = chosen ? of_property_read_string(chosen, "bootargs", &cmdline) : -ENOENT;
+	of_node_put(chosen);
+	if (ret) {
+		pr_err("[ZTE_LDD_BOOT][BOARDSTATE][ERR] no bootargs in /chosen\n");
+		return ret;
+	}
+	if (!cmdline_value(cmdline, BOARDID_CMDLINE_STR, &v))
+		boardid = v;
+	if (!cmdline_value(cmdline, EFUSE_STATE_CMDLINE_STR, &v))
+		efuse_state = v == EFUSE_ENABLE_VALUE;
+
+	ret = misc_register(&zte_board_state_dev);
+	if (ret) {
+		pr_err("[ZTE_LDD_BOOT][BOARDSTATE][ERR] cannot register the misc device: %d\n", ret);
+		return ret;
+	}
+	if (!proc_create_single("driver/board_id", 0444, NULL, board_id_show))
+		pr_warn("[ZTE_LDD_BOOT][BOARDSTATE][WARN] cannot create /proc/driver/board_id\n");
+	pr_info("[ZTE_LDD_BOOT][BOARDSTATE][INFO] board id %d, secure boot %d\n", boardid, efuse_state);
+	return 0;
+}
+module_init(zte_board_state_init);
+
+MODULE_LICENSE("Dual BSD/GPL");
+MODULE_DESCRIPTION("ZTE board state");
